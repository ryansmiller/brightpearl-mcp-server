# Brightpearl private app credentials (Settings → API → Private apps)
BRIGHTPEARL_ACCOUNT=          # your Brightpearl account code
BRIGHTPEARL_DATACENTER=       # e.g. use1 → https://use1.brightpearlconnect.com/public-api/...
BRIGHTPEARL_APP_REF=
BRIGHTPEARL_ACCOUNT_TOKEN=

# Google Cloud
GCP_PROJECT_ID=
BQ_DATASET=brightpearl
# For local dev prefer: gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# MCP server (remote deployment) — Google OAuth, users sign in with their
# Workspace account. Client created in GCP console (consent screen: Internal).
MCP_BASE_URL=                 # public URL of the deployed server, e.g. https://mcp-server-....run.app
GOOGLE_OAUTH_CLIENT_ID=       # ....apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=   # from Secret Manager: google-oauth-client-secret
WEBHOOK_TOKEN=               # shared secret for webhook ingest + scheduler endpoints
